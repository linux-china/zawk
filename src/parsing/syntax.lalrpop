/// This is the parser we have. I am by no means comfortable writing parsing
/// code like this, but I do think that this code is better and more
/// maintainable than if I had written the parser by hand.
use crate::{
  arena::Arena,
  ast::{expr_key, Pattern, Expr, Stmt, Binop, Unop, Prog, FunDec},
  builtins::Function,
  common::{FileSpec, Either},
  runtime::{strtod,exact_int_literal,parse_int_literal,parse_hex_literal},
  lexer::{self, Tok},
};

grammar<'a>(
  arena: &'a Arena,
  buf: &mut Vec<u8>,
  prog: &mut Prog<'a, 'a, &'a str>,
);

ToplevelBase: () = {
   <Begin> => { prog.begin.push(<>); },
   <End> => { prog.end.push(<>); },
   <Prepare> => { prog.prepare.push(<>); },
   <BeginFile> => { prog.beginfile.push(<>); },
   <EndFile> => { prog.endfile.push(<>); },
   <Function> => prog.decs.push(<>),
}

ToplevelBraced: () = {
  ToplevelBase,
  <PatAction> => prog.pats.push(<>),
}

UnbracedPattern: () = {
  <Expr> "\n"+ => prog.pats.push((Pattern::Bool(<>), None)),
  <Expr> SemiSep => prog.pats.push((Pattern::Bool(<>), None)),
  <e1:Expr> "," "\n"* <e2:Expr> "\n"+ => prog.pats.push((Pattern::Comma(e1, e2), None)),
  <e1:Expr> "," "\n"* <e2:Expr> SemiSep => prog.pats.push((Pattern::Comma(e1, e2), None)),
}

ProgInner: () = {
  UnbracedPattern,
  ToplevelBraced,
  ProgInner ToplevelBraced,
  ProgInner UnbracedPattern,
}

pub Prog: () = {
  "\n"* ProgInner? =>? crate::parsing::check_local_names(prog),
}

Function: FunDec<'a, 'a, &'a str> = {
    <name:"FUNDEC"> "(" <args:FormalParams?> Rparen <body:Block> => {
        let args = args.unwrap_or(Default::default());
        let params = args.len();
        FunDec {
          name,
          body,
          args: crate::parsing::end_function_scope(args, arena, prog),
          params,
        }
    }
}

FormalParams: Vec<&'a str> = {
   <"IDENT"> => vec![<>],
   <v:(<"IDENT"> "," "\n"*)+> <iopt:(<"IDENT">)?> => match iopt {
      Some(e) => { let mut v = v; v.push(e); v }
      None => v,
   }
}

Begin: &'a Stmt<'a,'a,&'a str> = {
    "BEGIN" "\n"* <b:Block> => crate::parsing::end_rule_scope(b, arena, prog),
}

Prepare: &'a Stmt<'a,'a,&'a str> = {
    "PREPARE" "\n"* <b:Block> => crate::parsing::end_rule_scope(b, arena, prog),
}

BeginFile: &'a Stmt<'a,'a,&'a str> = {
    "BEGINFILE" "\n"* <b:Block> => crate::parsing::end_rule_scope(b, arena, prog),
}

EndFile: &'a Stmt<'a,'a,&'a str> = {
    "ENDFILE" "\n"* <b:Block> => crate::parsing::end_rule_scope(b, arena, prog),
}

End: &'a Stmt<'a,'a,&'a str> = {
    "END" "\n"* <b:Block> => crate::parsing::end_rule_scope(b, arena, prog),
}

PatAction: (Pattern<'a,'a,&'a str>, Option<&'a Stmt<'a,'a,&'a str>>) = {
  <p:Expr?> <b:Block> => (match p {
                   Some(e) => Pattern::Bool(e),
                   None => Pattern::Null,
              }, Some(crate::parsing::end_rule_scope(b, arena, prog))),
  // A range pattern: both ends are full expressions, as in `NR == 1, NR == 3`.
  <l:Expr> "," "\n"* <r:Expr> <b:Block> =>
      (Pattern::Comma(l, r), Some(crate::parsing::end_rule_scope(b, arena, prog))),
}

// Resolving if/else groupings courtesy of wikipedia

Stmt: &'a Stmt<'a, 'a, &'a str> = {
    OpenStmt,
    ClosedStmt,
}

OpenStmt: &'a Stmt<'a,'a,&'a str> = {
    "if" "(" <cond:Expr> Rparen <s1:ClosedStmt> Else <s2:OpenStmt> => arena.alloc(Stmt::If(cond, s1, Some(s2))),
    "if" "(" <cond:Expr> Rparen <s1:Stmt> => arena.alloc(Stmt::If(cond, s1, None)),
    "while" "(" <cond:Expr> Rparen <body:OpenStmt> => arena.alloc(Stmt::While(false, cond, body)),
    "for" "(" <init: ExprNoIn?> ";" <cond:Expr?> ";" <update:Expr?> Rparen <body:OpenStmt> =>
        arena.alloc(Stmt::For(
                init.map(|x| arena.alloc(Stmt::Expr(x))),
                cond,
                update.map(|x| arena.alloc(Stmt::Expr(x))),
                body
        )),
    <l:@L> "for" "(" <id:"IDENT"> "in" <arr:Expr> Rparen <body:OpenStmt> =>?
        crate::parsing::foreach(id, arr, body, l, arena, prog),
    <l:@L> "for" "(" <k:"IDENT"> "," <v:"IDENT"> "in" <arr:Expr> Rparen <body:OpenStmt> =>?
        crate::parsing::foreach_kv(k, v, arr, body, l, arena, prog),
    <l:@L> "for" "(" <id:"IDENT"> "in" <start:Expr> <r:RangeOp> <end:Expr> Rparen <body:OpenStmt> =>?
        crate::parsing::for_range(id, start, end, r, body, l, arena, prog),
}

ClosedStmt: &'a Stmt<'a,'a,&'a str> = {
    BaseStmt,
    "if" "(" <cond:Expr> Rparen <s1:ClosedStmt> Else <s2:ClosedStmt> =>
           arena.alloc(Stmt::If(cond, s1, Some(s2))),
    "while" "(" <cond:Expr> Rparen <body:ClosedStmt> => arena.alloc(Stmt::While(false, cond, body)),
    "for" "(" <init: ExprNoIn?> ";" <cond:Expr?> ";" <update:Expr?> Rparen <body:ClosedStmt> =>
        arena.alloc(Stmt::For(
                init.map(|x| arena.alloc(Stmt::Expr(x))),
                cond,
                update.map(|x| arena.alloc(Stmt::Expr(x))),
                body
        )),
    <l:@L> "for" "(" <id:"IDENT"> "in" <arr:Expr> Rparen <body:ClosedStmt> =>?
        crate::parsing::foreach(id, arr, body, l, arena, prog),
    <l:@L> "for" "(" <k:"IDENT"> "," <v:"IDENT"> "in" <arr:Expr> Rparen <body:ClosedStmt> =>?
        crate::parsing::foreach_kv(k, v, arr, body, l, arena, prog),
    <l:@L> "for" "(" <id:"IDENT"> "in" <start:Expr> <r:RangeOp> <end:Expr> Rparen <body:ClosedStmt> =>?
        crate::parsing::for_range(id, start, end, r, body, l, arena, prog),


    Do <body:BaseStmt> "while" "(" <cond:Expr> ")" Sep => arena.alloc(Stmt::DoWhile(cond, body)),
    "switch" "(" <e:Expr> Rparen Lbrace <cases:SwitchCase*> Rbrace =>? {
        crate::parsing::check_switch_cases(&cases)?;
        let cases: Vec<_> = cases.into_iter().map(|(_, label, body)| (label, body)).collect();
        Ok(arena.alloc(Stmt::Switch(e, arena.alloc_slice(&cases[..]))))
    },
}

// The `..` (exclusive) or `..=` (inclusive) of a range in `for (i in start..end)`.
RangeOp: bool = {
    ".." => false,
    "..=" => true,
}

// A case of a switch statement, whose body runs until the next case label.
SwitchCase: crate::parsing::SwitchCase<'a> = {
    <loc:@L> <label:CaseLabel> ":" "\n"* <body:Stmt*> =>
        (loc, label, arena.alloc(Stmt::Block(arena.new_vec_from_slice(&body[..])))),
}

// As in gawk, a case label is a numeric constant (optionally signed), a string constant or a regex
// constant.
CaseLabel: Option<&'a Expr<'a,'a,&'a str>> = {
    "default" => None,
    "case" <CaseValue> => Some(<>),
}

CaseValue: &'a Expr<'a,'a,&'a str> = {
    CaseNum,
    "+" <CaseNum>,
    "-" <n:CaseNum> => arena.alloc(match n {
        Expr::ILit(i) if *i != i64::MIN => Expr::ILit(-*i),
        Expr::ILit(i) => Expr::FLit(-(*i as f64)),
        Expr::FLit(f) => Expr::FLit(-*f),
        _ => unreachable!(),
    }),
    <l:@L> <s:"STRLIT"> => {
      let e: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::StrLit(lexer::parse_string_literal(s, &arena, buf)));
      prog.locs.insert(expr_key(e), l);
      e
  },
    <l:@L> <s:"RAWSTRLIT"> => {
      let e: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::StrLit(arena.alloc_bytes(s.as_bytes())));
      prog.locs.insert(expr_key(e), l);
      e
  },
    "PATLIT" => arena.alloc(Expr::PatLit(lexer::parse_regex_literal(<>, &arena, buf))),
}

CaseNum: &'a Expr<'a,'a,&'a str> = {
  "INT" => arena.alloc(exact_int_literal(parse_int_literal(<>.as_bytes())).map_or_else(Expr::FLit, Expr::ILit)),
  "HEX" => arena.alloc(exact_int_literal(parse_hex_literal(<>.as_bytes())).map_or_else(Expr::FLit, Expr::ILit)),
  "FLOAT" => arena.alloc(Expr::FLit(strtod(<>.as_bytes()))),
}

// getline is an operand of the comparison operators, so its result can be assigned and compared:
// `while (getline line < file > 0)`, `r = getline`, `while ("cmd" | getline > 0)`.
//
// `getline [var] < file` reads the file named by a concatenation, so a following `> 0` is a
// comparison (gawk reads `getline x < f ".txt"` as `(getline x < f) ".txt"`; zawk reads the file
// `f ".txt"`).
GetlineFile: &'a Expr<'a, 'a, &'a str> = {
    "getline" <into:PrecFieldRef?> "<" <from:PrecCat> =>
      arena.alloc(Expr::Getline{into, from: Some(from), is_file: true}),
}

// `getline [var]` reads the main input. It is not the left operand of `<` or `<=`, where `<` is an
// input redirection.
GetlinePlain: &'a Expr<'a, 'a, &'a str> = {
    "getline" <into:PrecFieldRef?> =>
      arena.alloc(Expr::Getline{into, from: None, is_file: true}),
}

// `cmd | getline [var]`.
GetlineCmd: &'a Expr<'a, 'a, &'a str> = {
    <from:PrecCat> "|" "getline" <into:PrecFieldRef?> =>
      arena.alloc(Expr::Getline{into, from: Some(from), is_file: false}),
}

// The left operand of `<` and `<=`. `cmd | getline` is not available in unparenthesized print
// arguments (G == "NoGt"), where `|` is an output pipe.
CmpLhsNoLt<G>: &'a Expr<'a, 'a, &'a str> = {
    PrecCat,
    GetlineFile,
    GetlineCmd if G == "Gt",
}

// The left operand of the other comparison operators.
CmpLhs<G>: &'a Expr<'a, 'a, &'a str> = {
    CmpLhsNoLt<G>,
    GetlinePlain,
}

// The target is a concatenation of non-comparison expressions (gawk's `common_exp`), so that
// e.g. `print 1 > 2 ? "a" : "b"` is a syntax error rather than a write to the file "a".
// The location of the target is kept (unless it has its own), for `zawk lint`.
Redirect: (&'a Expr<'a, 'a, &'a str>, FileSpec) = {
    ">" <l:@L> <e:PrecCat> => {
        prog.locs.entry(expr_key(e)).or_insert(l);
        (e, FileSpec::Trunc)
    },
    ">>" <l:@L> <e:PrecCat> => {
        prog.locs.entry(expr_key(e)).or_insert(l);
        (e, FileSpec::Append)
    },
    "|" <l:@L> <e:PrecCat> => {
        prog.locs.entry(expr_key(e)).or_insert(l);
        (e, FileSpec::Cmd)
    },
}

BaseStmt: &'a Stmt<'a, 'a, &'a str> = {
   <LeafStmt> Sep => <>,
   StmtBlock,
   // The empty statement, e.g. `while (x--) ;` or `{ ; }`.
   SemiSep => arena.alloc(Stmt::Block(arena.new_vec())),
}

LeafStmt: &'a Stmt<'a, 'a, &'a str> = {
    <l:@L> <e: Expr> =>? crate::parsing::expr_stmt(e, l, arena),
    "delete" <i: IndexBase> =>
        arena.alloc(Stmt::Expr(arena.alloc(Expr::Call(Either::Right(Function::Delete), arena.alloc_slice(&[i.0, i.1]))))),
    "delete" <b: LeafTerm> =>
        arena.alloc(Stmt::Expr(arena.alloc(Expr::Call(Either::Right(Function::Clear), arena.alloc_slice(&[b]))))),
    "print" <pa:PrintArgs?> <re:Redirect?> =>
        arena.alloc(Stmt::Print(arena.alloc_slice(pa.unwrap_or_else(Vec::new).as_slice()), re)),
    "print(" "\n"* <pa:(<Args?>)> ")" <re:Redirect?> =>
        arena.alloc(Stmt::Print(arena.alloc_slice(pa.unwrap_or_else(Vec::new).as_slice()), re)),
    // The location of `printf` is kept under its format, for `zawk lint`.
    <l:@L> "printf" <spec:PrintExpr> <pa: ("," "\n"* <PrintArgs>)?> <re:Redirect?> => {
        prog.locs.insert(expr_key(spec), l);
        arena.alloc(Stmt::Printf(spec, arena.alloc_slice(pa.unwrap_or_else(Vec::new).as_slice()), re))
    },
    <l:@L> "printf(" "\n"* <spec:(<Expr> "\n"*)> <pa: ("," "\n"* <Args>)?> ")" <re:Redirect?> => {
        prog.locs.insert(expr_key(spec), l);
        arena.alloc(Stmt::Printf(spec, arena.alloc_slice(pa.unwrap_or_else(Vec::new).as_slice()), re))
    },
    // `exit` without a code has no argument: in END it keeps the code of an earlier `exit`.
    "exit" <PrecCat?> =>
       arena.alloc(Stmt::Expr(arena.alloc(Expr::Call(Either::Right(Function::Exit),
                                                     arena.alloc_slice(<>.as_slice()))))),
    "exit(" <Expr?> ")" =>
       arena.alloc(Stmt::Expr(arena.alloc(Expr::Call(Either::Right(Function::Exit),
                                                     arena.alloc_slice(<>.as_slice()))))),
    "break" => arena.alloc(Stmt::Break),
    "continue" => arena.alloc(Stmt::Continue),
    "next" => arena.alloc(Stmt::Next),
    "nextfile" => arena.alloc(Stmt::NextFile),
    "return" <Expr?> => arena.alloc(Stmt::Return(<>)),
    "local" <LocalDecls> =>? crate::parsing::local_stmt(<>, arena, prog),
}

// The declarations of a `local` statement: `local x, y = 1, arr[]`.
LocalDecls: Vec<crate::parsing::LocalDecl<'a>> = {
    <LocalDecl> => vec![<>],
    <v:LocalDecls> "," "\n"* <d:LocalDecl> => { let mut v = v; v.push(d); v },
}

LocalDecl: crate::parsing::LocalDecl<'a> = {
    <l:@L> <i:"IDENT"> =>? crate::parsing::declare_local(i, None, false, l, arena, prog),
    <l:@L> <i:"IDENT"> "[" "]" =>? crate::parsing::declare_local(i, None, true, l, arena, prog),
    <l:@L> <i:"IDENT"> "=" <e:Expr> =>? crate::parsing::declare_local(i, Some(e), false, l, arena, prog),
}

// The block of a rule or function, which may be followed by a `;`.
Block: &'a Stmt<'a,'a,&'a str> = {
    <StmtBlock> SemiSep? => <>,
}

// A block statement; a `;` after it is an empty statement.
StmtBlock: &'a Stmt<'a,'a,&'a str> = {
    Lbrace Rbrace => arena.alloc(Stmt::Block(arena.new_vec())),
    Lbrace <LeafStmt> Rbrace => <>,
    Lbrace <BlockInner> Rbrace => arena.alloc(Stmt::Block(arena.new_vec_from_slice(&<>[..]))),
}

BlockInner: Vec<&'a Stmt<'a,'a,&'a str>> = {
    <v:(<Stmt>)+> <e:LeafStmt?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

PrintArgs: Vec<&'a Expr<'a,'a,&'a str>> = {
    <PrintExpr> => vec![<>],
    <v:(<PrintExpr> "," "\n"*)+> <e:PrintExpr> => { let mut v = v; v.push(e); v },
}

// An expression in the argument list of print or printf. To avoid ambiguity with output
// redirection, an unparenthesized `>` comparison is not allowed (as in POSIX awk and gawk); all
// other operators are. Parenthesized subexpressions use the full grammar.
PrintExpr: &'a Expr<'a,'a,&'a str> = PrecAsgn<"NoGt">;

Args: Vec<&'a Expr<'a,'a,&'a str>> = {
    // To avoid ambiguities with expressions including ">" we jump down the precedence hierarchy
    // past the comparison operators.
    <Expr> => vec![<>],
    <v:(<Expr> "," "\n"*)+> <e:(<Expr> "\n"*)?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

Expr: &'a Expr<'a,'a,&'a str> = PrecAsgn<"Gt">;

PrecAsgn<G>: &'a Expr<'a,'a,&'a str> = {
    <l: PrecIn<G>> "=" <r: PrecAsgn<G>> => arena.alloc(Expr::Assign(l, r)),
    <l: PrecIn<G>> "+=" <r: PrecAsgn<G>> => arena.alloc(Expr::AssignOp(l, Binop::Plus, r)),
    <l: PrecIn<G>> "-=" <r: PrecAsgn<G>> => arena.alloc(Expr::AssignOp(l, Binop::Minus, r)),
    <l: PrecIn<G>> "*=" <r: PrecAsgn<G>> => arena.alloc(Expr::AssignOp(l, Binop::Mult, r)),
    <l: PrecIn<G>> "/=" <r: PrecAsgn<G>> => arena.alloc(Expr::AssignOp(l, Binop::Div, r)),
    <l: PrecIn<G>> "^=" <r: PrecAsgn<G>> => arena.alloc(Expr::AssignOp(l, Binop::Pow, r)),
    <l: PrecIn<G>> "%=" <r: PrecAsgn<G>> => arena.alloc(Expr::AssignOp(l, Binop::Mod, r)),
    // `l ??= r` is `l ?? (l = r)`: `r` is evaluated and assigned only when `l` is false as a
    // strnum. An array element's subscript is evaluated once (see `Nullish` in cfg.rs).
    <l: PrecIn<G>> "??=" <r: PrecAsgn<G>> => arena.alloc(Expr::Nullish(l, arena.alloc(Expr::Assign(l, r)))),
    PrecTern<G>,
}

LookupList: &'a Expr<'a, 'a, &'a str> = {
    <first:PrecMatch<"Gt">> <rest:("," "\n"* <PrecMatch<"Gt">>)+> => {
      let mut res = first;
      let subsep = arena.alloc(Expr::Var("SUBSEP"));
      for dim in rest.into_iter() {
        res = arena.alloc(Expr::Binop(Binop::Concat, res, subsep));
        res = arena.alloc(Expr::Binop(Binop::Concat, res, dim));
      }
      res
   }
}

PrecTern<G>: &'a Expr<'a, 'a, &'a str> = {
   <c: PrecOr<G>> "?" "\n"* <t: PrecAsgn<G>> ":" "\n"* <f: PrecAsgn<G>> => arena.alloc(Expr::ITE(c, t, f)),
   PrecOr<G>,
}

PrecOr<G>: &'a Expr<'a, 'a, &'a str> = {
    <l: PrecAnd<G>> Or <r: PrecOr<G>> => arena.alloc(Expr::Or(l, r)),
    PrecAnd<G>,
}

PrecAnd<G>: &'a Expr<'a, 'a, &'a str> = {
    <l: PrecIn<G>> And <r: PrecAnd<G>> => arena.alloc(Expr::And(l, r)),
    PrecIn<G>,
}

PrecIn<G>: &'a Expr<'a,'a,&'a str> = {
    InMatch<G>,
    PrecMatch<G>,
}

// The right operand of `in` is an array name, as in POSIX (`non_unary_expr In NAME`). As in gawk,
// the result of `k in arr` may be the left operand of comparison and match operators:
// `k in seen == 0` is `(k in seen) == 0` and `1 in a ~ x` is `(1 in a) ~ x`.
InTerm<G>: &'a Expr<'a,'a,&'a str> = {
    <l: PrecMatch<G>> "in" <r: Ident> =>
        arena.alloc(Expr::Call(Either::Right(Function::Contains), arena.alloc_slice(&[r, l]))),
    "(" <l: LookupList> Rparen "in" <r: Ident> =>
        arena.alloc(Expr::Call(Either::Right(Function::Contains), arena.alloc_slice(&[r, l]))),
    <l: InMatch<G>> "in" <r: Ident> =>
        arena.alloc(Expr::Call(Either::Right(Function::Contains), arena.alloc_slice(&[r, l]))),
    // `k !in arr` is `!(k in arr)`, as in Kotlin.
    <l: PrecMatch<G>> "!in" <r: Ident> =>
        arena.alloc(Expr::Unop(Unop::Not, arena.alloc(Expr::Call(Either::Right(Function::Contains), arena.alloc_slice(&[r, l]))))),
    "(" <l: LookupList> Rparen "!in" <r: Ident> =>
        arena.alloc(Expr::Unop(Unop::Not, arena.alloc(Expr::Call(Either::Right(Function::Contains), arena.alloc_slice(&[r, l]))))),
    <l: InMatch<G>> "!in" <r: Ident> =>
        arena.alloc(Expr::Unop(Unop::Not, arena.alloc(Expr::Call(Either::Right(Function::Contains), arena.alloc_slice(&[r, l]))))),
}

InCmp<G>: &'a Expr<'a,'a,&'a str> = {
    <l: InTerm<G>> "<" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::LT, l, r)),
    <l: InTerm<G>> "<=" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::LTE, l, r)),
    <l: InTerm<G>> ">" <r: PrecCat> if G == "Gt" => arena.alloc(Expr::Binop(Binop::GT, l, r)),
    <l: InTerm<G>> ">=" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::GTE, l, r)),
    <l: InTerm<G>> "==" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::EQ, l, r)),
    <l: InTerm<G>> "!=" <r: PrecCat> => arena.alloc(Expr::Unop(Unop::Not, arena.alloc(Expr::Binop(Binop::EQ, l, r)))),
    InTerm<G>,
}

InMatch<G>: &'a Expr<'a,'a,&'a str> = {
    <l: InMatch<G>> "~" <r: PrecCmp<G>> => arena.alloc(Expr::Binop(Binop::IsMatch, l, r)),
    <l: InMatch<G>> "!~" <r: PrecCmp<G>> => arena.alloc(Expr::Unop(
            Unop::Not,
            arena.alloc(Expr::Binop(Binop::IsMatch, l, r)))),
    InCmp<G>,
}

PrecMatch<G>: &'a Expr<'a,'a,&'a str> = {
    <l: PrecMatch<G>> "~" <r: PrecCmp<G>> => arena.alloc(Expr::Binop(Binop::IsMatch, l, r)),
    <l: PrecMatch<G>> "!~" <r: PrecCmp<G>> => arena.alloc(Expr::Unop(
            Unop::Not,
            arena.alloc(Expr::Binop(Binop::IsMatch, l, r)))),
    PrecCmp<G>,
}

// XXX Replicate the first two layers of the precedence hierarchy to skip "in" expressions to avoid
// ambiguity between beginning of for loop and foreach loop. This is a hack; we should find a way
// to tell LALRPOP the right thing here.
ExprNoIn: &'a Expr<'a,'a,&'a str> = PrecAsgnNoIn;

PrecAsgnNoIn: &'a Expr<'a,'a,&'a str> = {
    <l: PrecMatch<"Gt">> "=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::Assign(l, r)),
    <l: PrecMatch<"Gt">> "+=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::AssignOp(l, Binop::Plus, r)),
    <l: PrecMatch<"Gt">> "-=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::AssignOp(l, Binop::Minus, r)),
    <l: PrecMatch<"Gt">> "*=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::AssignOp(l, Binop::Mult, r)),
    <l: PrecMatch<"Gt">> "/=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::AssignOp(l, Binop::Div, r)),
    <l: PrecMatch<"Gt">> "^=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::AssignOp(l, Binop::Pow, r)),
    <l: PrecMatch<"Gt">> "%=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::AssignOp(l, Binop::Mod, r)),
    <l: PrecMatch<"Gt">> "??=" <r: PrecAsgn<"Gt">> => arena.alloc(Expr::Nullish(l, arena.alloc(Expr::Assign(l, r)))),
    PrecTernNoIn,
}

PrecTernNoIn: &'a Expr<'a, 'a, &'a str> = {
   <c: PrecOrNoIn> "?" "\n"* <t: PrecAsgn<"Gt">> ":" "\n"* <f: PrecAsgn<"Gt">> => arena.alloc(Expr::ITE(c, t, f)),
   PrecOrNoIn,
}

PrecOrNoIn: &'a Expr<'a, 'a, &'a str> = {
    <l: PrecAndNoIn> Or <r: PrecOrNoIn> => arena.alloc(Expr::Or(l, r)),
    PrecAndNoIn,
}

PrecAndNoIn: &'a Expr<'a, 'a, &'a str> = {
    <l: PrecMatch<"Gt">> And <r: PrecAndNoIn> => arena.alloc(Expr::And(l, r)),
    PrecMatch<"Gt">,
}


// Comparison operators are non-associative, as in POSIX awk, gawk and onetrue awk: a chain such
// as `a < b < c` is a syntax error and needs parentheses.
PrecCmp<G>: &'a Expr<'a,'a,&'a str> = {
    <l: CmpLhsNoLt<G>> "<" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::LT, l, r)),
    <l: CmpLhsNoLt<G>> "<=" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::LTE, l, r)),
    // Not in unparenthesized print arguments, where `>` is output redirection.
    <l: CmpLhs<G>> ">" <r: PrecCat> if G == "Gt" => arena.alloc(Expr::Binop(Binop::GT, l, r)),
    <l: CmpLhs<G>> ">=" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::GTE, l, r)),
    <l: CmpLhs<G>> "==" <r: PrecCat> => arena.alloc(Expr::Binop(Binop::EQ, l, r)),
    <l: CmpLhs<G>> "!=" <r: PrecCat> => arena.alloc(Expr::Unop(Unop::Not, arena.alloc(Expr::Binop(Binop::EQ, l, r)))),
    CmpLhs<G>
}

// Concatenation binds looser than the arithmetic operators and tighter than comparisons. Its right
// operand may not start with a unary `+`/`-` (as in POSIX `non_unary_expr`), so `a -1` is a
// subtraction, nor with a prefix `++`/`--`, so `x++ y` is a postfix increment (as in gawk).
PrecCat: &'a Expr<'a,'a,&'a str> = {
    <l: PrecCat> <r: PrecAdd<"NU">> => arena.alloc(Expr::Binop(Binop::Concat, l, r)),
    PrecAdd<"U">,
}

// The `U` parameter is "U" when the expression may start with a unary sign or a prefix
// increment, and "NU" when it may not.
PrecAdd<U>: &'a Expr<'a,'a,&'a str> = {
    <l: PrecAdd<U>> "+" <r:PrecMul<"U">>  => arena.alloc(Expr::Binop(Binop::Plus, l, r)),
    <l: PrecAdd<U>> "-" <r:PrecMul<"U">>  => arena.alloc(Expr::Binop(Binop::Minus, l, r)),
    PrecMul<U>,
}

PrecMul<U>: &'a Expr<'a,'a,&'a str> = {
    <l: PrecMul<U>> "*" <r:PrecUnop<"U">> => arena.alloc(Expr::Binop(Binop::Mult, l, r)),
    <l: PrecMul<U>> "/" <r:PrecUnop<"U">> => arena.alloc(Expr::Binop(Binop::Div, l, r)),
    <l: PrecMul<U>> "%" <r:PrecUnop<"U">> => arena.alloc(Expr::Binop(Binop::Mod, l, r)),
    PrecUnop<U>,
}

// Unary operators bind looser than `^`: `-2 ^ 2` is `-(2 ^ 2)`.
PrecUnop<U>: &'a Expr<'a,'a,&'a str> = {
    "-" <e: PrecUnop<"U">> if U == "U" => arena.alloc(Expr::Unop(Unop::Neg, e)),
    "+" <e: PrecUnop<"U">> if U == "U" => arena.alloc(Expr::Unop(Unop::Pos, e)),
    "!" <e: PrecUnop<"U">> => arena.alloc(Expr::Unop(Unop::Not, e)),
    PrecPow<U>,
}

// `^` is right associative, and its right operand may have a sign: `2 ^ -1`.
PrecPow<U>: &'a Expr<'a, 'a, &'a str> = {
    <l: PrecInc<U>> "^" <r: PrecUnop<"U">> => arena.alloc(Expr::Binop(Binop::Pow, l, r)),
    PrecInc<U>,
}

PrecInc<U>: &'a Expr<'a,'a,&'a str> = {
    <l: PrecInc<U>> "??" <r: NullishRhs> => arena.alloc(Expr::Nullish(l, r)),
    IncTerm<U>,
}

// `l ?? r` is `r` when `l` is uninitialized, empty or zero (including strings like "0.0"), and `l`
// otherwise; `l` is evaluated once. It binds tighter than any other operator except `++`/`--`:
// `"Hello " name ?? "Guest"` is `"Hello " (name ?? "Guest")`, `-u ?? 5` is `-(u ?? 5)` and
// `i++ ?? 1` is `(i++) ?? 1`. It is left associative. The right operand is a term, optionally
// with `++`/`--` or preceded by unary `-`, `+` or `!` (`u ?? -1`, `u ?? x++`); a following `^`
// applies to the whole `??`, so `u ?? 2 ^ 2` is `(u ?? 2) ^ 2`.
NullishRhs: &'a Expr<'a,'a,&'a str> = {
    "-" <e: NullishRhs> => arena.alloc(Expr::Unop(Unop::Neg, e)),
    "+" <e: NullishRhs> => arena.alloc(Expr::Unop(Unop::Pos, e)),
    "!" <e: NullishRhs> => arena.alloc(Expr::Unop(Unop::Not, e)),
    IncTerm<"U">,
}

IncTerm<U>: &'a Expr<'a,'a,&'a str> = {
    <e:PrecFieldRef> "++" => arena.alloc(Expr::Inc { is_inc: true, is_post: true, x: e }),
    <e:PrecFieldRef> "--" => arena.alloc(Expr::Inc { is_inc: false, is_post: true, x: e }),
    "++" <e:PrecFieldRef> if U == "U" => arena.alloc(Expr::Inc { is_inc: true, is_post: false, x: e }),
    "--" <e:PrecFieldRef> if U == "U" => arena.alloc(Expr::Inc { is_inc: false, is_post: false, x: e }),
    PrecFieldRef,
}

PrecFieldRef: &'a Expr<'a,'a,&'a str> = {
    Col,
    BaseTerm
}

Col: &'a Expr<'a,'a,&'a str> = {
    <l:@L> "$" <e:BaseTerm> => {
        let c: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::Unop(Unop::Column, e));
        prog.locs.insert(expr_key(c), l);
        c
    },
}

Ident: &'a Expr<'a,'a,&'a str> = {
  // `length` without parentheses is `length($0)`; it is a builtin, not a variable.
  <l:@L> <i:"IDENT"> => {
      if i == "length" {
          let e: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::Call(Either::Right(Function::Length), &[]));
          prog.locs.insert(expr_key(e), l);
          e
      } else {
          crate::parsing::var(arena.alloc_str(i), l, arena, prog)
      }
  },
}

StrLit: &'a Expr<'a,'a,&'a str> = {
  <l:@L> <s:"STRLIT"> => {
      let e: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::StrLit(lexer::parse_string_literal(s, &arena, buf)));
      prog.locs.insert(expr_key(e), l);
      e
  },
  <l:@L> <s:"FSTRLIT"> =>? crate::parsing::parse_fstring_literal(s, l, arena, buf, prog),
  <l:@L> <s:"RAWSTRLIT"> => {
      let e: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::StrLit(arena.alloc_bytes(s.as_bytes())));
      prog.locs.insert(expr_key(e), l);
      e
  },
}

Index: &'a Expr<'a,'a,&'a str> = {
    <l:@L> <i:IndexBase> => {
        let e: &'a Expr<'a,'a,&'a str> = arena.alloc(Expr::Index(i.0, i.1));
        prog.locs.insert(expr_key(e), l);
        e
    },
}

IndexBase: (&'a Expr<'a,'a,&'a str>, &'a Expr<'a,'a,&'a str>) = {
  <arr:BaseTerm> "[" <e:Expr> "]" => (arr, e),
  <arr:BaseTerm> "[" <ll:LookupList> "]" => (arr, ll),
}

BaseTerm: &'a Expr<'a,'a, &'a str> = {
  LeafTerm,
  Index,
  "(" <e:Expr> ")" => e,
}

LeafTerm: &'a Expr<'a,'a, &'a str> = {
  Ident,
  StrLit,
  // Integer literals that are not exact as doubles (beyond 2^53) become floating-point literals.
  "INT" => arena.alloc(exact_int_literal(parse_int_literal(<>.as_bytes())).map_or_else(Expr::FLit, Expr::ILit)),
  "HEX" => arena.alloc(exact_int_literal(parse_hex_literal(<>.as_bytes())).map_or_else(Expr::FLit, Expr::ILit)),
  "FLOAT" => arena.alloc(Expr::FLit(strtod(<>.as_bytes()))),
  "PATLIT" => arena.alloc(Expr::PatLit(lexer::parse_regex_literal(<>, &arena, buf))),
  // TODO: not Rparen for these next two?
  <l:@L> <i:CallStart> <args:Args?> ")" => {
        let mut args = args.unwrap_or_else(Vec::new);
        // match(s, re, arr) writes `arr[n, "start"]`: pass SUBSEP along, as `a[i, j]` reads it.
        if i == "match" && args.len() >= 3 {
            args.push(arena.alloc(Expr::Var("SUBSEP")));
        }
        let e: &'a Expr<'a,'a,&'a str> =
            arena.alloc(Expr::Call(Either::Left(i), arena.alloc_slice(args.as_slice())));
        prog.locs.insert(expr_key(e), l);
        e
  },
}

And: () = { "&&" "\n"* }
Or: () = { "||" "\n"* }
Do: () = { "do" "\n"* }
Else: () = { "else" "\n"* }
Lbrace: () = { "{" "\n"* }
Rbrace: () = { "}" "\n"* }
#[inline]
Rparen: () = { ")" "\n"* }
SemiSep: () = { ";" "\n"* }
Sep: () = { "\n"+, ";" "\n"* }
CallStart: &'a str = {
   <"CALLSTART"> "\n"*
}

extern {
  type Location = lexer::Loc;
  type Error = lexer::Error;
  enum Tok<'a> {
      "INT" => Tok::ILit(<&'a str>),
      "HEX" => Tok::HexLit(<&'a str>),
      "FLOAT" => Tok::FLit(<&'a str>),
      "IDENT" => Tok::Ident(<&'a str>),
      "STRLIT" => Tok::StrLit(<&'a str>),
      "FSTRLIT" => Tok::FStrLit(<&'a str>),
      "RAWSTRLIT" => Tok::RawStrLit(<&'a str>),
      "PATLIT" => Tok::PatLit(<&'a str>),
      "CALLSTART" => Tok::CallStart(<&'a str>),
      "FUNDEC" => Tok::FunDec(<&'a str>),
      "BEGIN" =>  Tok::Begin,
      "PREPARE" => Tok::Prepare,
      "BEGINFILE" => Tok::BeginFile,
      "ENDFILE" => Tok::EndFile,
      "END" =>  Tok::End,
      "break" =>  Tok::Break,
      "continue" =>  Tok::Continue,
      "next" =>  Tok::Next,
      "nextfile" =>  Tok::NextFile,
      "for" =>  Tok::For,
      "if" =>  Tok::If,
      "else" => Tok::Else,
      "print" =>  Tok::Print,
      "print(" =>  Tok::PrintLP,
      "printf" =>  Tok::Printf,
      "printf(" =>  Tok::PrintfLP,
      "exit" => Tok::Exit,
      "exit(" => Tok::ExitLP,
      "while" =>  Tok::While,
      "do" =>  Tok::Do,
      "switch" => Tok::Switch,
      "case" => Tok::Case,
      "default" => Tok::Default,
      "{" =>  Tok::LBrace,
      "}" =>  Tok::RBrace,
      "[" =>  Tok::LBrack,
      "]" =>  Tok::RBrack,
      "(" =>  Tok::LParen,
      ")" =>  Tok::RParen,
      "getline" =>  Tok::Getline,
      "|" => Tok::Pipe,
      "=" =>  Tok::Assign,
      "+" =>  Tok::Add,
      "+=" =>  Tok::AddAssign,
      "-" =>  Tok::Sub,
      "-=" =>  Tok::SubAssign,
      "*" =>  Tok::Mul,
      "*=" =>  Tok::MulAssign,
      "/" =>  Tok::Div,
      "/=" =>  Tok::DivAssign,
      "^" =>  Tok::Pow,
      "^=" =>  Tok::PowAssign,
      "%" =>  Tok::Mod,
      "%=" =>  Tok::ModAssign,
      "~" =>  Tok::Match,
      "!~" =>  Tok::NotMatch,
      "==" =>  Tok::EQ,
      "!=" =>  Tok::NEQ,
      "<" =>  Tok::LT,
      "<=" =>  Tok::LTE,
      ">" =>  Tok::GT,
      "--" =>  Tok::Decr,
      "++" =>  Tok::Incr,
      ">=" =>  Tok::GTE,
      ">>" =>  Tok::Append,
      ";" =>  Tok::Semi,
      "$" => Tok::Dollar,
      "\n" =>  Tok::Newline,
      "," =>  Tok::Comma,
      "!" => Tok::Not,
      "||" => Tok::OR,
      "&&" => Tok::AND,
      "?" => Tok::QUESTION,
      "??" => Tok::Nullish,
      "??=" => Tok::NullishAssign,
      ":" => Tok::COLON,
      "delete" => Tok::Delete,
      "in" => Tok::In,
      "!in" => Tok::NotIn,
      ".." => Tok::DotDot,
      "..=" => Tok::DotDotEq,
      "return" => Tok::Return,
      "local" => Tok::Local,
  }
}
